theme = Selenized Light

# Fonts: Monaspace, mixed per style
font-family = "Monaspace Neon"
font-family-bold = "Monaspace Xenon"
font-family-italic = "Monaspace Radon"
font-family-bold-italic = "Monaspace Krypton"
font-size = 14

font-style-bold = "Bold"
font-style-bold-italic = "Bold Italic"

# Texture healing, ligatures, discretionary ligatures
font-feature = +calt
font-feature = +liga
font-feature = +dlig

# All ten ligature groups
font-feature = +ss01
font-feature = +ss02
font-feature = +ss03
font-feature = +ss04
font-feature = +ss05
font-feature = +ss06
font-feature = +ss07
font-feature = +ss08
font-feature = +ss09
font-feature = +ss10
